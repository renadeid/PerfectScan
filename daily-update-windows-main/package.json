{
  "name": "daily-update-windows",
  "version": "1.0.0",
  "description": "Windows desktop app to detect and update apps, CLIs, and git repos",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/scanner.test.js",
    "build": "electron-builder --win --dir",
    "package": "electron-builder --win"
  },
  "keywords": [
    "update",
    "git",
    "winget",
    "windows"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dailyupdate.windows",
    "productName": "Daily Update",
    "icon": "Assets/icon.png",
    "win": {
      "target": "nsis",
      "sign": false,
      "icon": "Assets/icon.png"
    },
    "files": [
      "src/**/*",
      "Assets/icon.png",
      "package.json"
    ],
    "publish": null
  },
  "allowScripts": {
    "electron@44.0.0": true
  }
}
